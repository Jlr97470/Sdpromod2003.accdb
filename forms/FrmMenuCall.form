                    Width =9882
                    Height =1965
                    Name ="LstSocietesAppels"
                    RowSourceType ="Table/Query"
                    RowSource ="SELECT SelSocietesSTAVillesContactsTAInscrit.SocNum, SelSocietesSTAVillesContact"
                        "sTAInscrit.SocSTA, SelSocietesSTAVillesContactsTAInscrit.SocRaison, SelSocietesS"
                        "TAVillesContactsTAInscrit.ConCivCode, SelSocietesSTAVillesContactsTAInscrit.ConN"
                        "om, SelSocietesSTAVillesContactsTAInscrit.ConPrenom, SelSocietesAppels3.SocAppNo"
                        "m, SelSocietesAppels3.SocAppNotes, SelSocietesAppels3.SocAppDateRappel, SelSocie"
                        "tesAppels3.SocAppHeureRappel, Not IsNull(TBLSOCIETESCALL1.SocCallNum) AS SocCall"
                        "1, Not IsNull(TBLSOCIETESCALL2.SocCallNum) AS SocCall2, Not IsNull(TBLSOCIETESCA"
                        "LL3.SocCallNum) AS SocCall3 FROM (((SelSocietesSTAVillesContactsTAInscrit LEFT J"
                        "OIN TBLSOCIETESCALL3 ON SelSocietesSTAVillesContactsTAInscrit.SocNum=TBLSOCIETES"
                        "CALL3.SocCallSocNum) LEFT JOIN SelSocietesAppels3 ON SelSocietesSTAVillesContact"
                        "sTAInscrit.SocNum=SelSocietesAppels3.SocAppSocNum) LEFT JOIN TBLSOCIETESCALL2 ON"
                        " SelSocietesSTAVillesContactsTAInscrit.SocNum=TBLSOCIETESCALL2.SocCallSocNum) LE"
                        "FT JOIN TBLSOCIETESCALL1 ON SelSocietesSTAVillesContactsTAInscrit.SocNum=TBLSOCI"
                        "ETESCALL1.SocCallSocNum WHERE (((IsNull(TBLSOCIETESCALL3.SocCallNum))=True) And "
                        "((SelSocietesSTAVillesContactsTAInscrit.SocAdh)=True)) ORDER BY SelSocietesSTAVi"
                        "llesContactsTAInscrit.SocSTA; "
                    ColumnWidths ="0;1134;1134;567;1134;1134;1134;1134;1134;1134;0;0;0"
                    AfterUpdate ="[Event Procedure]"
                    OnDblClick ="[Event Procedure]"

                End
            End
        End
